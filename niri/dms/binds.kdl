binds {
    Mod+B repeat=false { close-window; }
    Mod+I { move-column-to-monitor-right; }
    Mod+J { focus-monitor-left; }
    Mod+K { focus-monitor-right; }
    Mod+U { move-column-to-monitor-left; }
    Mod+Ctrl+Y hotkey-overlay-title="Run Application (New Instance)" { spawn "niri-run-or-raise" "--force-new"; }
    Mod+Apostrophe hotkey-overlay-title="Lock the Screen" { spawn "lock"; }
    Mod+Y hotkey-overlay-title="Search & Open App" { spawn "app-search"; }
}
